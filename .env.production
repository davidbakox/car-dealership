NEXT_PUBLIC_SITE_URL=https://dennis-cars-carei.pages.dev
NEXT_PUBLIC_ADMIN_PATH=/admin-9f3k2
NEXT_PUBLIC_CF_IMAGE_RESIZING=false
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-78934d920885471b80cc54de78c4d299.r2.dev
