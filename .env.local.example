# ---- Supabase (from Project Settings → API) ----
# Safe to expose to the browser (used with anon key + RLS):
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SERVER-ONLY. Never prefix with NEXT_PUBLIC_. Bypasses RLS.
# Used only by the seed script and server-only admin operations.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# SERVER-ONLY. The sole Supabase Auth user allowed into the admin area and
# permitted to request password recovery.
ADMIN_EMAIL=admin@example.com

# ---- Site ----
# Full origin, used for absolute Open Graph / canonical URLs.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# ---- Admin path (must match the folder under app/) ----
# Keep this obscure; the real protection is Supabase Auth + middleware.
NEXT_PUBLIC_ADMIN_PATH=/admin-9f3k2

# ---- Cloudflare Image Resizing ----
# Set to "true" once you've enabled Image Resizing on the Cloudflare zone.
# While "false" (or unset), next/image serves raw Supabase URLs (no resizing).
NEXT_PUBLIC_CF_IMAGE_RESIZING=false

# ---- Cloudflare R2 car images ----
# Keep the access keys server-only. Create a bucket-scoped Object Read & Write token.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=dennis-cars-dealership
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-your-bucket-id.r2.dev
